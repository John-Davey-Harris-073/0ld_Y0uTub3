# Скопируй в .env для локальной разработки
PORT=3000
# Максимальный размер видео в МБ
MAX_FILE_MB=100
# Папка для БД, видео и миниатюр (локально можно не задавать — data/)
#UPLOAD_DIR=./data
# Секрет для подписи cookie-сессий
SESSION_SECRET=some-long-random-string
# Для PostgreSQL (на Render задастся автоматически). Локально не нужно — используется SQLite.
#DATABASE_URL=postgres://user:pass@host:5432/db
