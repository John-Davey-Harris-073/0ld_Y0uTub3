<%- include('partials/header') %>
<h2 class="section-title">Results for "<%= query %>"</h2>
<% if (results.length === 0) { %>
  <p class="empty-note">No results found for "<%= query %>". Try different keywords.</p>
<% } %>
<% results.forEach(function (v) { %>
  <div class="search-row">
    <a href="/watch/<%= v.id %>"><img src="/thumbs/<%= v.id %>" alt="<%= v.title %>" width="160" height="120"></a>
    <div class="search-info">
      <a href="/watch/<%= v.id %>" class="search-title"><%= v.title %></a>
      <div class="search-sub">
        <a href="/channel/<%= v.username %>"><%= v.username %></a>
        <span class="gray">- <%= fmtViews(v.views) %> views - <%= fmtRel(v.created_at) %></span>
      </div>
      <% if (v.description) { %>
        <p class="search-snippet"><%= v.description.slice(0, 200) %></p>
      <% } %>
    </div>
  </div>
<% }) %>
<%- include('partials/footer') %>